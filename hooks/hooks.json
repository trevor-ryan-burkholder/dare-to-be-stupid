{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" || node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-fallback.cjs\""
          }
        ]
      }
    ]
  }
}
