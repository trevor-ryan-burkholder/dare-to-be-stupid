{
  "name": "meeseeks",
  "version": "0.141.0",
  "private": true,
  "type": "module",
  "description": "A Claude Code plugin: /meeseeks hands a PRD to an autonomous loop that designs, builds, gates, reviews and ships until it passes an enterprise definition of done, or the budget dies.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json",
    "test": "node --test \"test/*.test.mjs\"",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/*.test.mjs\"",
    "test:live": "node tools/run-live.mjs",
    "test:all": "npm test && npm run test:integration",
    "release-check": "node tools/release-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "typescript": "^7.0.2"
  }
}
